# clang-format — C++ code style for vc_image_utils.
# Apply with:  clang-format -i <files>   (or your editor's format-on-save).
# Editor-level whitespace equivalents live in .editorconfig.
---
Language:          Cpp
BasedOnStyle:      LLVM

# House overrides (chosen explicitly):
IndentWidth:       4
TabWidth:          4
UseTab:            Never
ColumnLimit:       100
PointerAlignment:  Left              # int* p
BreakBeforeBraces: Attach            # opening brace on the same line (K&R)
AllowShortFunctionsOnASingleLine: None  # always expand function bodies to multiple lines
BinPackParameters: false             # one parameter per line when a signature wraps
                                      # (AlignAfterOpenBracket: Align is the LLVM default —
                                      # continuation params align under the first one)

# Align trailing '//' comments to a common column across consecutive lines
# (tab-stop look) instead of a single space gap that varies per line length.
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
...
