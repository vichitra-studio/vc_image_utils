# Normalize line endings: store text as LF in the repo; check out native.
# Eliminates CRLF/LF diff churn when contributors are on different OSes.
* text=auto

# Source and text files (stored LF).
*.c              text
*.cc             text
*.cpp            text
*.cxx            text
*.h              text
*.hh             text
*.hpp            text
*.hxx            text
*.inl            text
*.ipp            text
*.tpp            text
*.py             text
*.sh             text eol=lf
*.md             text
*.txt            text
*.yml            text
*.yaml           text
*.cmake          text
CMakeLists.txt   text

# Binary assets — never diff, merge, or line-normalize these.
# Image / HDR / RAW formats expected by this project's tests and samples.
*.png            binary
*.jpg            binary
*.jpeg           binary
*.bmp            binary
*.gif            binary
*.ico            binary
*.tif            binary
*.tiff           binary
*.exr            binary
*.hdr            binary
*.dng            binary
*.raw            binary
*.cr2            binary
*.cr3            binary
*.nef            binary
*.arw            binary
*.raf            binary
*.orf            binary
*.rw2            binary
*.pdf            binary

# Vendored third-party code — preserve upstream bytes EXACTLY.
# `* text=auto` above is right for our own sources: it kills CRLF/LF churn
# between contributors on different systems. It is wrong for vendored code,
# where the point is that the tree can be verified byte-for-byte against the
# pinned upstream tag, and that a version bump diffs cleanly against it.
# Caught on the Eigen 5.0.1 vendor: Eigen ships exactly one CRLF file,
# Eigen/src/Core/arch/AVX512/PacketMathFP16.h, and `*.h text` silently
# rewrote its 1413 line endings on the way into the index — a file that no
# ARM build ever compiles, so nothing would have failed and nothing would
# have reported it. `-text` disables all line-ending translation for these
# paths. It changes no file already committed (those were stored LF, and
# -text checks them out LF unchanged); it only stops future normalization.
third_party/**  -text
